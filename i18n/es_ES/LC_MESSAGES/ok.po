msgid "保存当前账号配置"
msgstr "Guardar configuración de cuenta actual"

msgid "保存账号列表"
msgstr "Guardar lista de cuentas"

msgid "当前账号配置没有变化"
msgstr "No hay cambios en la configuración de cuenta actual"

msgid "该任务暂无可编辑配置项"
msgstr "Esta tarea no tiene ajustes editables"

msgid "截图测试"
msgstr "Prueba de captura"

msgid "就绪"
msgstr "Listo"

msgid "每行一个账号名，无需密码"
msgstr "Un nombre de cuenta por línea, sin contraseña"

msgid "配置默认隐藏，选择后展开对应配置项。"
msgstr "La configuración está oculta por defecto; seleccione para expandir."

msgid "清空当前任务覆盖"
msgstr "Borrar anulación de tarea actual"

msgid "清空当前账号全部覆盖"
msgstr "Borrar todas las anulaciones de cuenta"

msgid "请先选择账号"
msgstr "Seleccione primero una cuenta"

msgid "请先选择账号与任务"
msgstr "Seleccione primero una cuenta y una tarea"

msgid "任务"
msgstr "Tarea"

msgid "任务属性配置"
msgstr "Configuración de atributos de tarea"

msgid "选择任务后自动渲染属性控件"
msgstr "Representa los widgets de atributos tras seleccionar una tarea"

msgid "已保存当前账号配置"
msgstr "Configuración de cuenta actual guardada"

msgid "账号列表已保存（新建 {created}，复用 {reused}）"
msgstr "Lista de cuentas guardada (creadas {created}, reutilizadas {reused})"

msgid "已清空：{account} / {task} 覆盖"
msgstr "Anulación borrada: {account} / {task}"

msgid "已清空账号全部覆盖：{account}"
msgstr "Todas las anulaciones de cuenta borradas: {account}"

msgid "账号"
msgstr "Cuenta"

msgid "账号基础设置"
msgstr "Configuración básica de cuenta"

msgid "账号列表"
msgstr "Lista de cuentas"

msgid "账号列表操作"
msgstr "Acciones de lista de cuentas"

msgid "账号配置"
msgstr "Configuración de cuenta"

msgid "账号配置中心"
msgstr "Centro de configuración de cuenta"

msgid "账号任务覆盖操作"
msgstr "Acciones de anulación de tarea de cuenta"

msgid "账号任务选择"
msgstr "Selección de tarea de cuenta"

msgid "状态"
msgstr "Estado"

msgid "跳剧情"
msgstr "Saltar diálogo"

msgid "跳过剧情触发式任务：自动点击跳过对话框和确认按钮。"
msgstr ""
"Tarea de activación para saltar diálogos: hace clic automáticamente en los "
"botones de saltar diálogo y confirmar."

msgid "辅助星结"
msgstr "Asistencia de Vínculo Estelar"

msgid "星结辅助触发式任务：缔结星结时，光标指向目标出现可射击光圈，自动点击屏幕准心完成射击。"
msgstr ""
"Tarea de activación de asistencia de Vínculo Estelar: al forjar un Vínculo "
"Estelar, hace clic automáticamente en la mira para disparar cuando aparece "
"el anillo de disparo sobre el objetivo."

msgid "宝箱开锁"
msgstr "Desbloqueo de cofres"

msgid "进入开锁界面后启动任务，自动校准颜色条带并开锁。"
msgstr ""
"Inicia la tarea en la pantalla de la cerradura para calibrar las bandas de "
"color y abrir el cofre."

msgid "家园每日"
msgstr "Diario del hogar"

msgid "完成家园每日任务"
msgstr "Completa las tareas diarias del hogar"

msgid "执行家园每日：收菜、做饭、喂饭"
msgstr "Ejecutar el diario del hogar: cosechar, cocinar y alimentar"

#: src/tasks/onetime/auto_jenga_task.py
msgid "自动祖赞卡之梯"
msgstr "Escalera de Zuzanka automática"

#: src/tasks/onetime/auto_jenga_task.py
msgid "进入祖赞卡之梯后启动任务，自动放置图腾。"
msgstr ""
"Inicia la tarea en la escalera de Zuzanka para colocar los tótems "
"automáticamente."

#: src/tasks/onetime/auto_jenga_task.py
msgid "正在对准图腾"
msgstr "Alineando el tótem"

#: src/tasks/onetime/auto_jenga_task.py
msgid "祖赞卡之梯辅助已停止"
msgstr "Asistencia de la escalera de Zuzanka detenida"

msgid "每日收菜"
msgstr "Recompensa diaria"

msgid "执行每日收菜：邮件、惊喜盒子、日常/周常活跃、大月卡"
msgstr ""
"Ejecutar la recompensa diaria: correo, caja sorpresa, actividad "
"diaria/semanal, tarjeta mensual"

msgid "委托每日"
msgstr "Encargo diario"

msgid "执行委托每日：消耗体力刷选定的每日委托（需先解锁自动战斗）"
msgstr ""
"Ejecutar el encargo diario: gasta vigor para repetir el encargo diario "
"seleccionado (requiere desbloquear antes el combate automático)"

msgid "进入音游后启动任务，自动演奏当前曲目。"
msgstr ""
"Inicia la tarea en el juego de ritmo para tocar la canción actual "
"automáticamente."

msgid "任务队列"
msgstr "Cola de tareas"

msgid "队列空闲"
msgstr "Cola vacía"

msgid "项"
msgstr "elementos"

msgid "合计"
msgstr "Total"

msgid "队列悬浮窗"
msgstr "Ventana flotante de la cola"

msgid "位置与大小"
msgstr "Posición y tamaño"

msgid "当前状态"
msgstr "Estado actual"

msgid "选择图标"
msgstr "Elegir icono"

msgid "悬停窗口可以拖动，拖右下角改大小，松手自动保存。"
msgstr ""
"Arrastra la ventana para moverla y la esquina inferior derecha para "
"redimensionarla; se guarda automáticamente."

msgid "保存并应用"
msgstr "Guardar y aplicar"

msgid "恢复默认位置与大小"
msgstr "Restablecer posición y tamaño"

msgid "选择图标文件"
msgstr "Elegir un archivo de icono"

msgid "游戏在前台，已隐藏"
msgstr "Oculto (juego en primer plano)"

msgid "已恢复默认位置与大小"
msgstr "Posición y tamaño restablecidos"

msgid "启用队列悬浮窗"
msgstr "Activar la ventana flotante de la cola"

msgid "游戏在后台时显示（游戏在前台时永远不显示）"
msgstr "Mostrar cuando el juego está en segundo plano (nunca en primer plano)"

msgid "显示正在执行和排队中的任务；每项耗时取最近 5 次实际用时的平均值。"
msgstr ""
"Muestra las tareas en curso y en cola; cada estimación promedia las últimas "
"5 ejecuciones reales."

msgid "不透明度"
msgstr "Opacidad"

msgid "图标"
msgstr "Icono"

msgid "图标大小"
msgstr "Tamaño del icono"

msgid "左键单击图标展开队列，双击面板收回图标。"
msgstr ""
"Clic izquierdo en el icono para abrir la cola; doble clic en el panel para "
"volver al icono."

msgid "图标会一直留在任务栏上方，不会被任务栏盖住。"
msgstr ""
"El icono siempre queda por encima de la barra de tareas y nunca queda "
"oculto."

msgid "宽度"
msgstr "Ancho"

msgid "高度"
msgstr "Alto"

msgid "圆角"
msgstr "Radio de esquina"

msgid "最多显示"
msgstr "Mostrar como máximo"

msgid "队列里的耗时来自历史记录：每个任务保留最近 5 次，不足 5 次按已有次数平均。"
msgstr ""
"Las estimaciones salen del historial: cada tarea guarda sus últimas 5 "
"ejecuciones y promedia las disponibles."

msgid "悬浮窗尚未创建"
msgstr "La ventana flotante aún no se ha creado"

msgid "显示中"
msgstr "Mostrando"

msgid "未显示"
msgstr "Oculto"

msgid "已保存队列悬浮窗设置"
msgstr "Ajustes de la ventana flotante guardados"

msgid "已保存；重启程序后生效"
msgstr "Guardado; se aplicará tras reiniciar"

msgid "队列"
msgstr "Cola"
