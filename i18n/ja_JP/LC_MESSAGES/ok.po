msgid "保存当前账号配置"
msgstr "現在のアカウント設定を保存"

msgid "保存账号列表"
msgstr "アカウントリストを保存"

msgid "当前账号配置没有变化"
msgstr "現在のアカウント設定に変更はありません"

msgid "该任务暂无可编辑配置项"
msgstr "このタスクには編集可能な設定がありません"

msgid "截图测试"
msgstr "スクリーンショットテスト"

msgid "就绪"
msgstr "準備完了"

msgid "每行一个账号名，无需密码"
msgstr "1行にアカウント名を1つ、パスワード不要"

msgid "配置默认隐藏，选择后展开对应配置项。"
msgstr "設定は既定で非表示です。選択すると展開されます。"

msgid "清空当前任务覆盖"
msgstr "現在のタスク上書きをクリア"

msgid "清空当前账号全部覆盖"
msgstr "アカウントの全上書きをクリア"

msgid "请先选择账号"
msgstr "先にアカウントを選択してください"

msgid "请先选择账号与任务"
msgstr "先にアカウントとタスクを選択してください"

msgid "任务"
msgstr "タスク"

msgid "任务属性配置"
msgstr "タスク属性設定"

msgid "选择任务后自动渲染属性控件"
msgstr "タスク選択後に属性ウィジェットを描画します"

msgid "已保存当前账号配置"
msgstr "現在のアカウント設定を保存しました"

msgid "账号列表已保存（新建 {created}，复用 {reused}）"
msgstr "アカウントリストを保存しました（新規 {created}、再利用 {reused}）"

msgid "已清空：{account} / {task} 覆盖"
msgstr "上書きをクリアしました：{account} / {task}"

msgid "已清空账号全部覆盖：{account}"
msgstr "アカウントの全上書きをクリアしました：{account}"

msgid "账号"
msgstr "アカウント"

msgid "账号基础设置"
msgstr "アカウント基本設定"

msgid "账号列表"
msgstr "アカウントリスト"

msgid "账号列表操作"
msgstr "アカウントリスト操作"

msgid "账号配置"
msgstr "アカウント設定"

msgid "账号配置中心"
msgstr "アカウント設定センター"

msgid "账号任务覆盖操作"
msgstr "アカウントタスク上書き操作"

msgid "账号任务选择"
msgstr "アカウントタスク選択"

msgid "状态"
msgstr "状態"

msgid "跳剧情"
msgstr "ダイアログをスキップ"

msgid "跳过剧情触发式任务：自动点击跳过对话框和确认按钮。"
msgstr "ダイアログスキップトリガータスク：スキップダイアログと確認ボタンを自動でクリックします。"

msgid "辅助星结"
msgstr "星結アシスト"

msgid "星结辅助触发式任务：缔结星结时，光标指向目标出现可射击光圈，自动点击屏幕准心完成射击。"
msgstr ""
"星結アシストトリガータスク：星結を結ぶ際、カーソルがターゲットを捉えて射撃可能リングが表示されたら、画面中央のクロスヘアを自動クリックして射撃します。"

msgid "宝箱开锁"
msgstr "宝箱開錠"

msgid "进入开锁界面后启动任务，自动校准颜色条带并开锁。"
msgstr "解錠画面でタスクを開始すると、カラーバンドを調整して宝箱を開けます。"

msgid "家园每日"
msgstr "ホームデイリー"

msgid "完成家园每日任务"
msgstr "ホームデイリータスクを完了"

msgid "执行家园每日：收菜、做饭、喂饭"
msgstr "ホームデイリーを実行：収穫・料理・餌やり"

#: src/tasks/onetime/auto_jenga_task.py
msgid "自动祖赞卡之梯"
msgstr "ズザンカの梯子自動操作"

#: src/tasks/onetime/auto_jenga_task.py
msgid "进入祖赞卡之梯后启动任务，自动放置图腾。"
msgstr "ズザンカの梯子に入ってからタスクを開始すると、トーテムを自動で配置します。"

#: src/tasks/onetime/auto_jenga_task.py
msgid "正在对准图腾"
msgstr "トーテムの位置を合わせています"

#: src/tasks/onetime/auto_jenga_task.py
msgid "祖赞卡之梯辅助已停止"
msgstr "ズザンカの梯子の補助を停止しました"

msgid "每日收菜"
msgstr "デイリー報酬受け取り"

msgid "执行每日收菜：邮件、惊喜盒子、日常/周常活跃、大月卡"
msgstr ""
"デイリー報酬受け取りを実行：メール、サプライズボックス、デイリー/ウィークリー"
"活躍度、月間カード"

msgid "委托每日"
msgstr "依頼デイリー"

msgid "执行委托每日：消耗体力刷选定的每日委托（需先解锁自动战斗）"
msgstr ""
"依頼デイリーを実行：体力を消費して選択したデイリー依頼を周回（先にオートバトル"
"の解放が必要）"

msgid "进入音游后启动任务，自动演奏当前曲目。"
msgstr "音楽ゲームに入ってからタスクを開始すると、現在の曲を自動で演奏します。"

#: src/tasks/trigger/auto_sprint_task.py
msgid "自动冲刺"
msgstr "自動ダッシュ"

#: src/tasks/trigger/auto_sprint_task.py
msgid "当键盘按住 W/A/S/D 任意按键满 0.2 秒后，按设定间隔自动按下 Shift 冲刺。"
msgstr "W/A/S/D のいずれかを 0.2 秒間押し続けた後、設定した間隔で自動的に Shift キーを押してダッシュします。"

#: src/tasks/trigger/auto_sprint_task.py
msgid "冲刺间隔 (ms)"
msgstr "ダッシュ間隔 (ms)"

#: src/tasks/trigger/auto_sprint_task.py
msgid "按下 W/A/S/D 时自动按 Shift 冲刺的间隔时间（毫秒）。"
msgstr "W/A/S/D 押下中に自動で Shift を押す間隔（ミリ秒）。"

#: src/tasks/trigger/auto_pickup_task.py
msgid "自动拾取"
msgstr "自動採取"

#: src/tasks/trigger/auto_pickup_task.py
msgid "检测到可拾取提示时自动连按 F，直到提示消失。"
msgstr "採取アイコンを検出した際、消えるまで自動的に F キーを連打します。"
