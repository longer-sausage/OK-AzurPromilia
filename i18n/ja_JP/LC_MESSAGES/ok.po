msgid "保存当前账号配置"
msgstr "現在のアカウント設定を保存"

msgid "保存账号列表"
msgstr "アカウントリストを保存"

msgid "当前账号配置没有变化"
msgstr "現在のアカウント設定に変更はありません"

msgid "该任务暂无可编辑配置项"
msgstr "このタスクには編集可能な設定がありません"

msgid "截图测试"
msgstr "スクリーンショットテスト"

msgid "就绪"
msgstr "準備完了"

msgid "每行一个账号名，无需密码"
msgstr "1行にアカウント名を1つ、パスワード不要"

msgid "配置默认隐藏，选择后展开对应配置项。"
msgstr "設定は既定で非表示です。選択すると展開されます。"

msgid "清空当前任务覆盖"
msgstr "現在のタスク上書きをクリア"

msgid "清空当前账号全部覆盖"
msgstr "アカウントの全上書きをクリア"

msgid "请先选择账号"
msgstr "先にアカウントを選択してください"

msgid "请先选择账号与任务"
msgstr "先にアカウントとタスクを選択してください"

msgid "任务"
msgstr "タスク"

msgid "任务属性配置"
msgstr "タスク属性設定"

msgid "选择任务后自动渲染属性控件"
msgstr "タスク選択後に属性ウィジェットを描画します"

msgid "已保存当前账号配置"
msgstr "現在のアカウント設定を保存しました"

msgid "账号列表已保存（新建 {created}，复用 {reused}）"
msgstr "アカウントリストを保存しました（新規 {created}、再利用 {reused}）"

msgid "已清空：{account} / {task} 覆盖"
msgstr "上書きをクリアしました：{account} / {task}"

msgid "已清空账号全部覆盖：{account}"
msgstr "アカウントの全上書きをクリアしました：{account}"

msgid "账号"
msgstr "アカウント"

msgid "账号基础设置"
msgstr "アカウント基本設定"

msgid "账号列表"
msgstr "アカウントリスト"

msgid "账号列表操作"
msgstr "アカウントリスト操作"

msgid "账号配置"
msgstr "アカウント設定"

msgid "账号配置中心"
msgstr "アカウント設定センター"

msgid "账号任务覆盖操作"
msgstr "アカウントタスク上書き操作"

msgid "账号任务选择"
msgstr "アカウントタスク選択"

msgid "状态"
msgstr "状態"

msgid "跳剧情"
msgstr "ダイアログをスキップ"

msgid "跳过剧情触发式任务：自动点击跳过对话框和确认按钮。"
msgstr "ダイアログスキップトリガータスク：スキップダイアログと確認ボタンを自動でクリックします。"

msgid "辅助星结"
msgstr "星結アシスト"

msgid "星结辅助触发式任务：缔结星结时，光标指向目标出现可射击光圈，自动点击屏幕准心完成射击。"
msgstr ""
"星結アシストトリガータスク：星結を結ぶ際、カーソルがターゲットを捉えて射撃可能リングが表示されたら、画面中央のクロスヘアを自動クリックして射撃します。"

msgid "宝箱开锁"
msgstr "宝箱開錠"

msgid "进入开锁界面后启动任务，自动校准颜色条带并开锁。"
msgstr "解錠画面でタスクを開始すると、カラーバンドを調整して宝箱を開けます。"

msgid "家园每日"
msgstr "ホームデイリー"

msgid "完成家园每日任务"
msgstr "ホームデイリータスクを完了"

msgid "执行家园每日：收菜、做饭、喂饭"
msgstr "ホームデイリーを実行：収穫・料理・餌やり"

#: src/tasks/onetime/auto_jenga_task.py
msgid "自动祖赞卡之梯"
msgstr "ズザンカの梯子自動操作"

#: src/tasks/onetime/auto_jenga_task.py
msgid "进入祖赞卡之梯后启动任务，自动放置图腾。"
msgstr "ズザンカの梯子に入ってからタスクを開始すると、トーテムを自動で配置します。"

#: src/tasks/onetime/auto_jenga_task.py
msgid "正在对准图腾"
msgstr "トーテムの位置を合わせています"

#: src/tasks/onetime/auto_jenga_task.py
msgid "祖赞卡之梯辅助已停止"
msgstr "ズザンカの梯子の補助を停止しました"

msgid "每日收菜"
msgstr "デイリー報酬受け取り"

msgid "执行每日收菜：邮件、惊喜盒子、日常/周常活跃、大月卡"
msgstr "デイリー報酬受け取りを実行：メール、サプライズボックス、デイリー/ウィークリー活躍度、月間カード"

msgid "委托每日"
msgstr "依頼デイリー"

msgid "执行委托每日：消耗体力刷选定的每日委托（需先解锁自动战斗）"
msgstr "依頼デイリーを実行：体力を消費して選択したデイリー依頼を周回（先にオートバトルの解放が必要）"

msgid "进入音游后启动任务，自动演奏当前曲目。"
msgstr "音楽ゲームに入ってからタスクを開始すると、現在の曲を自動で演奏します。"

msgid "任务队列"
msgstr "タスクキュー"

msgid "队列空闲"
msgstr "キューは空です"

msgid "项"
msgstr "件"

msgid "合计"
msgstr "合計"

msgid "队列悬浮窗"
msgstr "キューのフローティング表示"

msgid "位置与大小"
msgstr "位置とサイズ"

msgid "当前状态"
msgstr "現在の状態"

msgid "选择图标"
msgstr "アイコンを選択"

msgid "悬停窗口可以拖动，拖右下角改大小，松手自动保存。"
msgstr "ウィンドウをドラッグで移動、右下隅のドラッグでサイズ変更。離すと自動保存します。"

msgid "保存并应用"
msgstr "保存して適用"

msgid "恢复默认位置与大小"
msgstr "位置とサイズを初期化"

msgid "选择图标文件"
msgstr "アイコンファイルを選択"

msgid "游戏在前台，已隐藏"
msgstr "ゲームが最前面のため非表示"

msgid "已恢复默认位置与大小"
msgstr "位置とサイズを初期化しました"

msgid "启用队列悬浮窗"
msgstr "キューのフローティング表示を有効にする"

msgid "游戏在后台时显示（游戏在前台时永远不显示）"
msgstr "ゲームがバックグラウンドのときだけ表示（最前面では表示しません）"

msgid "显示正在执行和排队中的任务；每项耗时取最近 5 次实际用时的平均值。"
msgstr "実行中と待機中のタスクを表示します。所要時間は直近 5 回の実測値の平均です。"

msgid "不透明度"
msgstr "不透明度"

msgid "图标"
msgstr "アイコン"

msgid "图标大小"
msgstr "アイコンサイズ"

msgid "左键单击图标展开队列，双击面板收回图标。"
msgstr "アイコンを左クリックでキューを展開、パネルをダブルクリックでアイコンに戻ります。"

msgid "图标会一直留在任务栏上方，不会被任务栏盖住。"
msgstr "アイコンは常にタスクバーの上にあり、タスクバーに隠れることはありません。"

msgid "宽度"
msgstr "幅"

msgid "高度"
msgstr "高さ"

msgid "圆角"
msgstr "角の丸み"

msgid "最多显示"
msgstr "最大表示数"

msgid "队列里的耗时来自历史记录：每个任务保留最近 5 次，不足 5 次按已有次数平均。"
msgstr "所要時間は履歴から算出します。各タスクは直近 5 回を保持し、5 回未満なら実績分の平均です。"

msgid "悬浮窗尚未创建"
msgstr "フローティング表示はまだ作成されていません"

msgid "显示中"
msgstr "表示中"

msgid "未显示"
msgstr "非表示"

msgid "已保存队列悬浮窗设置"
msgstr "キューのフローティング設定を保存しました"

msgid "已保存；重启程序后生效"
msgstr "保存しました。再起動後に反映されます"

msgid "队列"
msgstr "キュー"
