msgid "保存当前账号配置"
msgstr "現在のアカウント設定を保存"

msgid "保存账号列表"
msgstr "アカウントリストを保存"

msgid "当前账号配置没有变化"
msgstr "現在のアカウント設定に変更はありません"

msgid "该任务暂无可编辑配置项"
msgstr "このタスクには編集可能な設定がありません"

msgid "基础配置"
msgstr "基本設定"

msgid "键位配置"
msgstr "キー設定"

msgid "截图测试"
msgstr "スクリーンショットテスト"

msgid "就绪"
msgstr "準備完了"

msgid "每行一个账号名，无需密码"
msgstr "1行にアカウント名を1つ、パスワード不要"

msgid "配置默认隐藏，选择后展开对应配置项。"
msgstr "設定は既定で非表示です。選択すると展開されます。"

msgid "其他配置"
msgstr "その他の設定"

msgid "清空当前任务覆盖"
msgstr "現在のタスク上書きをクリア"

msgid "清空当前账号全部覆盖"
msgstr "アカウントの全上書きをクリア"

msgid "请先选择账号"
msgstr "先にアカウントを選択してください"

msgid "请先选择账号与任务"
msgstr "先にアカウントとタスクを選択してください"

msgid "全局配置"
msgstr "グローバル設定"

msgid "任务"
msgstr "タスク"

msgid "任务属性配置"
msgstr "タスク属性設定"

msgid "选择任务后自动渲染属性控件"
msgstr "タスク選択後に属性ウィジェットを描画します"

msgid "已保存当前账号配置"
msgstr "現在のアカウント設定を保存しました"

msgid "账号列表已保存（新建 {created}，复用 {reused}）"
msgstr "アカウントリストを保存しました（新規 {created}、再利用 {reused}）"

msgid "已清空：{account} / {task} 覆盖"
msgstr "上書きをクリアしました：{account} / {task}"

msgid "已清空账号全部覆盖：{account}"
msgstr "アカウントの全上書きをクリアしました：{account}"

msgid "游戏内快捷键配置"
msgstr "ゲーム内ホットキー設定"

msgid "账号"
msgstr "アカウント"

msgid "账号基础设置"
msgstr "アカウント基本設定"

msgid "账号列表"
msgstr "アカウントリスト"

msgid "账号列表操作"
msgstr "アカウントリスト操作"

msgid "账号配置"
msgstr "アカウント設定"

msgid "账号配置中心"
msgstr "アカウント設定センター"

msgid "账号任务覆盖操作"
msgstr "アカウントタスク上書き操作"

msgid "账号任务选择"
msgstr "アカウントタスク選択"

msgid "主界面单次动作后延迟"
msgstr "メイン画面の単一動作後遅延"

msgid "状态"
msgstr "状態"

msgid "Backpack Key"
msgstr "バックパックキー"

msgid "Interact Key"
msgstr "インタラクトキー"

msgid "Jump Key"
msgstr "ジャンプキー"

msgid "Map Key"
msgstr "マップキー"

msgid "SingleActionWithDelay"
msgstr "SingleActionWithDelay"

msgid "跳剧情"
msgstr "ダイアログをスキップ"

msgid "跳过剧情触发式任务：自动点击跳过对话框和确认按钮。"
msgstr "ダイアログスキップトリガータスク：スキップダイアログと確認ボタンを自動でクリックします。"

msgid "辅助星结"
msgstr "星結アシスト"

msgid "星结辅助触发式任务：缔结星结时，光标指向目标出现可射击光圈，自动点击屏幕准心完成射击。"
msgstr ""
"星結アシストトリガータスク：星結を結ぶ際、カーソルがターゲットを捉えて射撃可能リングが表示されたら、画面中央のクロスヘアを自動クリックして射撃します。"

msgid "宝箱开锁"
msgstr "宝箱開錠"

msgid "宝箱开锁触发式任务：校准颜色条带后按钥匙位置逐个点击开锁。"
msgstr "宝箱開錠のトリガータスク：カラーバンドを校正し、鍵の位置に合わせて順番にクリックして開錠します。"

msgid "家园每日"
msgstr "ホームデイリー"

msgid "完成家园每日任务"
msgstr "ホームデイリータスクを完了"

msgid "执行家园每日：收菜、做饭、喂饭"
msgstr "ホームデイリーを実行：収穫・料理・餌やり"

msgid "每日收菜"
msgstr "デイリー報酬受け取り"

msgid "执行每日收菜：邮件、惊喜盒子、日常/周常活跃、大月卡"
msgstr ""
"デイリー報酬受け取りを実行：メール、サプライズボックス、デイリー/ウィークリー"
"活躍度、月間カード"

msgid "委托每日"
msgstr "依頼デイリー"

msgid "执行委托每日：消耗体力刷选定的每日委托（需先解锁自动战斗）"
msgstr ""
"依頼デイリーを実行：体力を消費して選択したデイリー依頼を周回（先にオートバトル"
"の解放が必要）"
