msgid "保存当前账号配置"
msgstr "Save Current Account Settings"

msgid "保存账号列表"
msgstr "Save Account List"

msgid "当前账号配置没有变化"
msgstr "No changes to current account settings"

msgid "该任务暂无可编辑配置项"
msgstr "This task has no editable settings"

msgid "截图测试"
msgstr "Screenshot Test"

msgid "就绪"
msgstr "Ready"

msgid "每行一个账号名，无需密码"
msgstr "One account name per line, no password needed"

msgid "配置默认隐藏，选择后展开对应配置项。"
msgstr "Settings are hidden by default; select to expand."

msgid "清空当前任务覆盖"
msgstr "Clear Current Task Override"

msgid "清空当前账号全部覆盖"
msgstr "Clear All Account Overrides"

msgid "请先选择账号"
msgstr "Select an account first"

msgid "请先选择账号与任务"
msgstr "Select an account and a task first"

msgid "任务"
msgstr "Task"

msgid "任务属性配置"
msgstr "Task Attribute Settings"

msgid "选择任务后自动渲染属性控件"
msgstr "Renders the attribute widgets after selecting a task"

msgid "已保存当前账号配置"
msgstr "Current account settings saved"

msgid "账号列表已保存（新建 {created}，复用 {reused}）"
msgstr "Account list saved (created {created}, reused {reused})"

msgid "已清空：{account} / {task} 覆盖"
msgstr "Cleared override: {account} / {task}"

msgid "已清空账号全部覆盖：{account}"
msgstr "Cleared all account overrides: {account}"

msgid "账号"
msgstr "Account"

msgid "账号基础设置"
msgstr "Account Basic Settings"

msgid "账号列表"
msgstr "Account List"

msgid "账号列表操作"
msgstr "Account List Actions"

msgid "账号配置"
msgstr "Account Settings"

msgid "账号配置中心"
msgstr "Account Settings Center"

msgid "账号任务覆盖操作"
msgstr "Account Task Override Actions"

msgid "账号任务选择"
msgstr "Account Task Selection"

msgid "状态"
msgstr "Status"

msgid "跳剧情"
msgstr "Skip Dialog"

msgid "跳过剧情触发式任务：自动点击跳过对话框和确认按钮。"
msgstr ""
"Skip dialog trigger task: automatically click skip dialog and confirm "
"buttons."

msgid "辅助星结"
msgstr "Star Link Assist"

msgid "星结辅助触发式任务：缔结星结时，光标指向目标出现可射击光圈，自动点击屏幕准心完成射击。"
msgstr ""
"Star Link assist trigger task: while bonding a Star Link, automatically "
"clicks the screen crosshair to fire when the shootable ring appears over the"
" target."

msgid "宝箱开锁"
msgstr "Treasure Unlock"

msgid "进入开锁界面后启动任务，自动校准颜色条带并开锁。"
msgstr ""
"Start the task on the lock screen to calibrate the color bands and unlock "
"the chest."

msgid "家园每日"
msgstr "Home Daily"

msgid "完成家园每日任务"
msgstr "Complete home daily tasks"

msgid "执行家园每日：收菜、做饭、喂饭"
msgstr "Run home daily: harvest crops, cook, and feed"

#: src/tasks/onetime/auto_jenga_task.py
msgid "自动祖赞卡之梯"
msgstr "Auto Zuzanka’s Ladder"

#: src/tasks/onetime/auto_jenga_task.py
msgid "进入祖赞卡之梯后启动任务，自动放置图腾。"
msgstr "Start the task in Zuzanka’s Ladder to place totems automatically."

#: src/tasks/onetime/auto_jenga_task.py
msgid "正在对准图腾"
msgstr "Aligning the totem"

#: src/tasks/onetime/auto_jenga_task.py
msgid "祖赞卡之梯辅助已停止"
msgstr "Zuzanka’s Ladder assistance stopped"

msgid "每日收菜"
msgstr "Daily Claim"

msgid "执行每日收菜：邮件、惊喜盒子、日常/周常活跃、大月卡"
msgstr ""
"Run daily claim: mail, surprise box, daily/weekly activity, monthly card"

msgid "委托每日"
msgstr "Commission Daily"

msgid "执行委托每日：消耗体力刷选定的每日委托（需先解锁自动战斗）"
msgstr ""
"Run commission daily: spend power to farm the selected daily commission "
"(auto-combat must be unlocked first)"

msgid "进入音游后启动任务，自动演奏当前曲目。"
msgstr ""
"Start the task in the rhythm game to play the current song automatically."

#: src/tasks/trigger/auto_sprint_task.py
msgid "自动冲刺"
msgstr "Auto Sprint"

#: src/tasks/trigger/auto_sprint_task.py
msgid "按住 Shift 半秒后自动冲刺，松开即停止。"
msgstr "Hold Shift for half a second to start sprinting. Release it to stop."

#: src/tasks/trigger/auto_sprint_task.py
msgid "快速奔跑角色数量"
msgstr "Party size"

#: src/tasks/trigger/auto_sprint_task.py
msgid "1 人时只冲刺，2–3 人时按队伍顺序切人冲刺。"
msgstr ""
"With one character, keep sprinting. With two or three, switch characters in "
"party order while sprinting."

#: src/tasks/trigger/auto_pickup_task.py
msgid "自动拾取"
msgstr "Auto Pickup"

#: src/tasks/trigger/auto_pickup_task.py
msgid "检测到可拾取提示时自动连按 F，直到提示消失。"
msgstr ""
"Automatically presses F repeatedly when a pickup prompt is detected until it"
" disappears."

