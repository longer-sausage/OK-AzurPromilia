msgid "保存当前账号配置"
msgstr "儲存目前帳號配置"

msgid "保存账号列表"
msgstr "儲存帳號列表"

msgid "当前账号配置没有变化"
msgstr "目前帳號配置沒有變化"

msgid "该任务暂无可编辑配置项"
msgstr "該任務暫無可編輯配置項"

msgid "截图测试"
msgstr "截圖測試"

msgid "就绪"
msgstr "就緒"

msgid "每行一个账号名，无需密码"
msgstr "每行一個帳號名，無需密碼"

msgid "配置默认隐藏，选择后展开对应配置项。"
msgstr "配置預設隱藏，選擇後展開對應配置項。"

msgid "清空当前任务覆盖"
msgstr "清空目前任務覆蓋"

msgid "清空当前账号全部覆盖"
msgstr "清空目前帳號全部覆蓋"

msgid "请先选择账号"
msgstr "請先選擇帳號"

msgid "请先选择账号与任务"
msgstr "請先選擇帳號與任務"

msgid "任务"
msgstr "任務"

msgid "任务属性配置"
msgstr "任務屬性配置"

msgid "选择任务后自动渲染属性控件"
msgstr "選擇任務後自動渲染屬性控制項"

msgid "已保存当前账号配置"
msgstr "已儲存目前帳號配置"

msgid "账号列表已保存（新建 {created}，复用 {reused}）"
msgstr "帳號列表已儲存（新建 {created}，復用 {reused}）"

msgid "已清空：{account} / {task} 覆盖"
msgstr "已清空：{account} / {task} 覆蓋"

msgid "已清空账号全部覆盖：{account}"
msgstr "已清空帳號全部覆蓋：{account}"

msgid "账号"
msgstr "帳號"

msgid "账号基础设置"
msgstr "帳號基礎設定"

msgid "账号列表"
msgstr "帳號列表"

msgid "账号列表操作"
msgstr "帳號列表操作"

msgid "账号配置"
msgstr "帳號配置"

msgid "账号配置中心"
msgstr "帳號配置中心"

msgid "账号任务覆盖操作"
msgstr "帳號任務覆蓋操作"

msgid "账号任务选择"
msgstr "帳號任務選擇"

msgid "状态"
msgstr "狀態"

msgid "跳剧情"
msgstr "跳過劇情"

msgid "跳过剧情触发式任务：自动点击跳过对话框和确认按钮。"
msgstr "跳過劇情觸發式任務：自動點擊跳過對話框和確認按鈕。"

msgid "辅助星结"
msgstr "輔助星結"

msgid "星结辅助触发式任务：缔结星结时，光标指向目标出现可射击光圈，自动点击屏幕准心完成射击。"
msgstr "星結輔助觸發式任務：締結星結時，游標指向目標出現可射擊光圈，自動點擊螢幕準心完成射擊。"

msgid "宝箱开锁"
msgstr "寶箱開鎖"

msgid "进入开锁界面后启动任务，自动校准颜色条带并开锁。"
msgstr "進入開鎖介面後啟動任務，自動校準色帶並開鎖。"

msgid "家园每日"
msgstr "家園每日"

msgid "完成家园每日任务"
msgstr "完成家園每日任務"

msgid "执行家园每日：收菜、做饭、喂饭"
msgstr "執行家園每日：收菜、做飯、餵飯"

#: src/tasks/onetime/auto_jenga_task.py
msgid "自动祖赞卡之梯"
msgstr "自動祖贊卡之梯"

#: src/tasks/onetime/auto_jenga_task.py
msgid "进入祖赞卡之梯后启动任务，自动放置图腾。"
msgstr "進入祖贊卡之梯後啟動任務，自動放置圖騰。"

#: src/tasks/onetime/auto_jenga_task.py
msgid "正在对准图腾"
msgstr "正在對準圖騰"

#: src/tasks/onetime/auto_jenga_task.py
msgid "祖赞卡之梯辅助已停止"
msgstr "祖贊卡之梯輔助已停止"

msgid "每日收菜"
msgstr "每日收菜"

msgid "执行每日收菜：邮件、惊喜盒子、日常/周常活跃、大月卡"
msgstr "執行每日收菜：郵件、驚喜盒子、日常/週常活躍、大月卡"

msgid "委托每日"
msgstr "委託每日"

msgid "执行委托每日：消耗体力刷选定的每日委托（需先解锁自动战斗）"
msgstr "執行委託每日：消耗體力刷選定的每日委託（需先解鎖自動戰鬥）"

msgid "进入音游后启动任务，自动演奏当前曲目。"
msgstr "進入音遊後啟動任務，自動演奏目前曲目。"

#: src/tasks/trigger/auto_sprint_task.py
msgid "自动冲刺"
msgstr "自動衝刺"

#: src/tasks/trigger/auto_sprint_task.py
msgid "当键盘按住 W/A/S/D 任意按键满 0.2 秒后，按设定间隔自动按下 Shift 冲刺。"
msgstr "當鍵盤按住 W/A/S/D 任意按鍵滿 0.2 秒後，按設定間隔自動按下 Shift 衝刺。"

#: src/tasks/trigger/auto_sprint_task.py
msgid "冲刺间隔 (ms)"
msgstr "衝刺間隔 (ms)"

#: src/tasks/trigger/auto_sprint_task.py
msgid "按下 W/A/S/D 时自动按 Shift 冲刺的间隔时间（毫秒）。"
msgstr "按下 W/A/S/D 時自動按 Shift 衝刺的間隔時間（毫秒）。"

#: src/tasks/trigger/auto_pickup_task.py
msgid "自动拾取"
msgstr "自動拾取"

#: src/tasks/trigger/auto_pickup_task.py
msgid "检测到可拾取提示时自动连按 F，直到提示消失。"
msgstr "偵測到可拾取提示時自動連按 F，直到提示消失。"
