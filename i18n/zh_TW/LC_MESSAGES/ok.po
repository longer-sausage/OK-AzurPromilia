msgid "进入音游后启动任务，自动演奏当前曲目。"
msgstr "進入音遊後啟動任務，自動演奏目前曲目。"

#: src/tasks/trigger/auto_sprint_task.py
msgid "自动冲刺"
msgstr "自動衝刺"

#: src/tasks/trigger/auto_sprint_task.py
msgid "按住 Shift 半秒后自动冲刺，松开即停止。"
msgstr "按住 Shift 半秒後會自動衝刺，放開即停止。"

#: src/tasks/trigger/auto_sprint_task.py
msgid "快速奔跑角色数量"
msgstr "快速奔跑角色數量"

#: src/tasks/trigger/auto_sprint_task.py
msgid "1 人时只冲刺，2–3 人时按队伍顺序切人冲刺。"
msgstr "1 人時只衝刺，2–3 人時依隊伍順序切換角色衝刺。"

#: src/tasks/trigger/auto_pickup_task.py
msgid "自动拾取"
msgstr "自動拾取"

#: src/tasks/trigger/auto_pickup_task.py
msgid "检测到可拾取提示时自动连按 F，直到提示消失。"
msgstr "偵測到可拾取提示時自動連按 F，直到提示消失。"

