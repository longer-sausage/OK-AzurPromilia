msgid "保存当前账号配置"
msgstr "현재 계정 설정 저장"

msgid "保存账号列表"
msgstr "계정 목록 저장"

msgid "当前账号配置没有变化"
msgstr "현재 계정 설정에 변경 사항이 없습니다"

msgid "该任务暂无可编辑配置项"
msgstr "이 작업에는 편집 가능한 설정이 없습니다"

msgid "截图测试"
msgstr "스크린샷 테스트"

msgid "就绪"
msgstr "준비됨"

msgid "每行一个账号名，无需密码"
msgstr "한 줄에 계정 이름 하나, 비밀번호 불필요"

msgid "配置默认隐藏，选择后展开对应配置项。"
msgstr "설정은 기본적으로 숨겨져 있으며 선택하면 펼쳐집니다."

msgid "清空当前任务覆盖"
msgstr "현재 작업 재정의 지우기"

msgid "清空当前账号全部覆盖"
msgstr "계정의 모든 재정의 지우기"

msgid "请先选择账号"
msgstr "먼저 계정을 선택하세요"

msgid "请先选择账号与任务"
msgstr "먼저 계정과 작업을 선택하세요"

msgid "任务"
msgstr "작업"

msgid "任务属性配置"
msgstr "작업 속성 설정"

msgid "选择任务后自动渲染属性控件"
msgstr "작업 선택 후 속성 위젯을 렌더링합니다"

msgid "已保存当前账号配置"
msgstr "현재 계정 설정이 저장되었습니다"

msgid "账号列表已保存（新建 {created}，复用 {reused}）"
msgstr "계정 목록이 저장되었습니다 (새로 만듦 {created}, 재사용 {reused})"

msgid "已清空：{account} / {task} 覆盖"
msgstr "재정의가 지워졌습니다: {account} / {task}"

msgid "已清空账号全部覆盖：{account}"
msgstr "계정의 모든 재정의가 지워졌습니다: {account}"

msgid "账号"
msgstr "계정"

msgid "账号基础设置"
msgstr "계정 기본 설정"

msgid "账号列表"
msgstr "계정 목록"

msgid "账号列表操作"
msgstr "계정 목록 작업"

msgid "账号配置"
msgstr "계정 설정"

msgid "账号配置中心"
msgstr "계정 설정 센터"

msgid "账号任务覆盖操作"
msgstr "계정 작업 재정의 작업"

msgid "账号任务选择"
msgstr "계정 작업 선택"

msgid "状态"
msgstr "상태"

msgid "跳剧情"
msgstr "대화 건너뛰기"

msgid "跳过剧情触发式任务：自动点击跳过对话框和确认按钮。"
msgstr "대화 건너뛰기 트리거 작업: 건너뛰기 대화 상자와 확인 버튼을 자동으로 클릭합니다."

msgid "辅助星结"
msgstr "성결 보조"

msgid "星结辅助触发式任务：缔结星结时，光标指向目标出现可射击光圈，自动点击屏幕准心完成射击。"
msgstr ""
"성결 보조 트리거 작업: 성결을 맺을 때 커서가 대상을 가리켜 사격 가능 링이 표시되면 화면 중앙 조준점을 자동으로 클릭해 사격합니다."

msgid "宝箱开锁"
msgstr "보물상자 잠금 해제"

msgid "进入开锁界面后启动任务，自动校准颜色条带并开锁。"
msgstr "잠금 해제 화면에서 작업을 시작하면 색상 띠를 보정하고 보물상자를 엽니다."

msgid "家园每日"
msgstr "홈 데일리"

msgid "完成家园每日任务"
msgstr "홈 데일리 작업 완료"

msgid "执行家园每日：收菜、做饭、喂饭"
msgstr "홈 데일리 실행: 수확, 요리, 먹이 주기"

#: src/tasks/onetime/auto_jenga_task.py
msgid "自动祖赞卡之梯"
msgstr "주잔카의 사다리 자동 진행"

#: src/tasks/onetime/auto_jenga_task.py
msgid "进入祖赞卡之梯后启动任务，自动放置图腾。"
msgstr "주잔카의 사다리에 입장한 뒤 작업을 시작하면 토템을 자동으로 배치합니다."

#: src/tasks/onetime/auto_jenga_task.py
msgid "正在对准图腾"
msgstr "토템 위치 맞추는 중"

#: src/tasks/onetime/auto_jenga_task.py
msgid "祖赞卡之梯辅助已停止"
msgstr "주잔카의 사다리 보조 중지됨"

msgid "每日收菜"
msgstr "일일 보상 수령"

msgid "执行每日收菜：邮件、惊喜盒子、日常/周常活跃、大月卡"
msgstr "일일 보상 수령 실행: 우편, 서프라이즈 상자, 일일/주간 활동도, 월간 카드"

msgid "委托每日"
msgstr "의뢰 데일리"

msgid "执行委托每日：消耗体力刷选定的每日委托（需先解锁自动战斗）"
msgstr "의뢰 데일리 실행: 체력을 소모하여 선택한 일일 의뢰를 반복 (자동 전투를 먼저 해제해야 함)"

msgid "进入音游后启动任务，自动演奏当前曲目。"
msgstr "리듬 게임에 입장한 뒤 작업을 시작하면 현재 곡을 자동으로 연주합니다."

msgid "任务队列"
msgstr "작업 대기열"

msgid "队列空闲"
msgstr "대기열 비어 있음"

msgid "项"
msgstr "개"

msgid "合计"
msgstr "합계"

msgid "队列悬浮窗"
msgstr "작업 큐 오버레이"

msgid "位置与大小"
msgstr "위치 및 크기"

msgid "当前状态"
msgstr "현재 상태"

msgid "选择图标"
msgstr "아이콘 선택"

msgid "悬停窗口可以拖动，拖右下角改大小，松手自动保存。"
msgstr "창을 드래그해 이동하고, 오른쪽 아래 모서리를 끌어 크기를 바꿉니다. 놓으면 자동 저장됩니다."

msgid "保存并应用"
msgstr "저장 및 적용"

msgid "恢复默认位置与大小"
msgstr "위치와 크기 초기화"

msgid "选择图标文件"
msgstr "아이콘 파일 선택"

msgid "游戏在前台，已隐藏"
msgstr "게임이 전면이라 숨김"

msgid "已恢复默认位置与大小"
msgstr "위치와 크기를 초기화했습니다"

msgid "启用队列悬浮窗"
msgstr "작업 큐 오버레이 사용"

msgid "游戏在后台时显示（游戏在前台时永远不显示）"
msgstr "게임이 백그라운드일 때 표시 (전면일 때는 표시 안 함)"

msgid "显示正在执行和排队中的任务；每项耗时取最近 5 次实际用时的平均值。"
msgstr "실행 중이거나 대기 중인 작업을 표시합니다. 소요 시간은 최근 5회 실측값의 평균입니다."

msgid "不透明度"
msgstr "불투명도"

msgid "图标"
msgstr "아이콘"

msgid "图标大小"
msgstr "아이콘 크기"

msgid "左键单击图标展开队列，双击面板收回图标。"
msgstr "아이콘을 왼쪽 클릭하면 대기열이 열리고, 패널을 더블 클릭하면 아이콘으로 돌아갑니다."

msgid "图标会一直留在任务栏上方，不会被任务栏盖住。"
msgstr "아이콘은 항상 작업 표시줄 위에 있어 작업 표시줄에 가려지지 않습니다."

msgid "宽度"
msgstr "너비"

msgid "高度"
msgstr "높이"

msgid "圆角"
msgstr "모서리 반경"

msgid "最多显示"
msgstr "최대 표시"

msgid "队列里的耗时来自历史记录：每个任务保留最近 5 次，不足 5 次按已有次数平均。"
msgstr "소요 시간은 기록에서 계산합니다. 작업마다 최근 5회를 보관하고, 5회 미만이면 있는 만큼 평균합니다."

msgid "悬浮窗尚未创建"
msgstr "오버레이가 아직 생성되지 않았습니다"

msgid "显示中"
msgstr "표시 중"

msgid "未显示"
msgstr "표시 안 됨"

msgid "已保存队列悬浮窗设置"
msgstr "작업 큐 오버레이 설정을 저장했습니다"

msgid "已保存；重启程序后生效"
msgstr "저장했습니다. 재시작 후 적용됩니다"

msgid "队列"
msgstr "대기열"
