msgid "保存当前账号配置"
msgstr "현재 계정 설정 저장"

msgid "保存账号列表"
msgstr "계정 목록 저장"

msgid "当前账号配置没有变化"
msgstr "현재 계정 설정에 변경 사항이 없습니다"

msgid "该任务暂无可编辑配置项"
msgstr "이 작업에는 편집 가능한 설정이 없습니다"

msgid "基础配置"
msgstr "기본 설정"

msgid "键位配置"
msgstr "키 설정"

msgid "截图测试"
msgstr "스크린샷 테스트"

msgid "就绪"
msgstr "준비됨"

msgid "每行一个账号名，无需密码"
msgstr "한 줄에 계정 이름 하나, 비밀번호 불필요"

msgid "配置默认隐藏，选择后展开对应配置项。"
msgstr "설정은 기본적으로 숨겨져 있으며 선택하면 펼쳐집니다."

msgid "其他配置"
msgstr "기타 설정"

msgid "清空当前任务覆盖"
msgstr "현재 작업 재정의 지우기"

msgid "清空当前账号全部覆盖"
msgstr "계정의 모든 재정의 지우기"

msgid "请先选择账号"
msgstr "먼저 계정을 선택하세요"

msgid "请先选择账号与任务"
msgstr "먼저 계정과 작업을 선택하세요"

msgid "全局配置"
msgstr "전역 설정"

msgid "任务"
msgstr "작업"

msgid "任务属性配置"
msgstr "작업 속성 설정"

msgid "选择任务后自动渲染属性控件"
msgstr "작업 선택 후 속성 위젯을 렌더링합니다"

msgid "已保存当前账号配置"
msgstr "현재 계정 설정이 저장되었습니다"

msgid "账号列表已保存（新建 {created}，复用 {reused}）"
msgstr "계정 목록이 저장되었습니다 (새로 만듦 {created}, 재사용 {reused})"

msgid "已清空：{account} / {task} 覆盖"
msgstr "재정의가 지워졌습니다: {account} / {task}"

msgid "已清空账号全部覆盖：{account}"
msgstr "계정의 모든 재정의가 지워졌습니다: {account}"

msgid "游戏内快捷键配置"
msgstr "게임 내 단축키 설정"

msgid "账号"
msgstr "계정"

msgid "账号基础设置"
msgstr "계정 기본 설정"

msgid "账号列表"
msgstr "계정 목록"

msgid "账号列表操作"
msgstr "계정 목록 작업"

msgid "账号配置"
msgstr "계정 설정"

msgid "账号配置中心"
msgstr "계정 설정 센터"

msgid "账号任务覆盖操作"
msgstr "계정 작업 재정의 작업"

msgid "账号任务选择"
msgstr "계정 작업 선택"

msgid "主界面单次动作后延迟"
msgstr "메인 화면 단일 동작 후 지연"

msgid "状态"
msgstr "상태"

msgid "Backpack Key"
msgstr "가방 키"

msgid "Interact Key"
msgstr "상호작용 키"

msgid "Jump Key"
msgstr "점프 키"

msgid "Map Key"
msgstr "지도 키"

msgid "SingleActionWithDelay"
msgstr "SingleActionWithDelay"

msgid "跳剧情"
msgstr "대화 건너뛰기"

msgid "跳过剧情触发式任务：自动点击跳过对话框和确认按钮。"
msgstr "대화 건너뛰기 트리거 작업: 건너뛰기 대화 상자와 확인 버튼을 자동으로 클릭합니다."

msgid "辅助星结"
msgstr "성결 보조"

msgid "星结辅助触发式任务：缔结星结时，光标指向目标出现可射击光圈，自动点击屏幕准心完成射击。"
msgstr ""
"성결 보조 트리거 작업: 성결을 맺을 때 커서가 대상을 가리켜 사격 가능 링이 표시되면 화면 중앙 조준점을 자동으로 클릭해 사격합니다."

msgid "宝箱开锁"
msgstr "보물상자 잠금 해제"

msgid "宝箱开锁触发式任务：校准颜色条带后按钥匙位置逐个点击开锁。"
msgstr "보물상자 잠금 해제 트리거 작업: 색상 밴드를 보정한 뒤 열쇠 위치에 따라 차례로 클릭하여 잠금을 해제합니다."

msgid "家园每日"
msgstr "홈 데일리"

msgid "完成家园每日任务"
msgstr "홈 데일리 작업 완료"

msgid "执行家园每日：收菜、做饭、喂饭"
msgstr "홈 데일리 실행: 수확, 요리, 먹이 주기"

msgid "每日收菜"
msgstr "일일 보상 수령"

msgid "执行每日收菜：邮件、惊喜盒子、日常/周常活跃、大月卡"
msgstr "일일 보상 수령 실행: 우편, 서프라이즈 상자, 일일/주간 활동도, 월간 카드"

msgid "委托每日"
msgstr "의뢰 데일리"

msgid "执行委托每日：消耗体力刷选定的每日委托（需先解锁自动战斗）"
msgstr ""
"의뢰 데일리 실행: 체력을 소모하여 선택한 일일 의뢰를 반복 (자동 전투를 먼저 "
"해제해야 함)"
